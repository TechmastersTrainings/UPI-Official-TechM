# Copy to backend/.env for local development. In staging/production, set these as real
# environment variables (never commit secrets). Generate secrets with:
#   .venv/bin/python -m app.cli generate-env-secrets

APP_ENV=development            # development | test | staging | production
LOG_LEVEL=INFO

# Aiven MySQL 8 (production/staging). Download the project CA certificate from the Aiven console.
# DATABASE_URL=mysql+pymysql://avnadmin:<password>@<host>.aivencloud.com:<port>/techmasters_pg?charset=utf8mb4
# DATABASE_SSL_CA=/etc/techmasters/aiven-ca.pem
# Local development without MySQL credentials:
DATABASE_URL=sqlite:///./techmasters_dev.db
DATABASE_SSL_CA=

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=
ENCRYPTION_KEYS=
HASH_PEPPER=

CORS_ORIGINS=http://localhost:5177
FRONTEND_BASE_URL=http://localhost:5177
COOKIE_SECURE=false            # must be true in staging/production (HTTPS)
COOKIE_DOMAIN=

REPORTING_UTC_OFFSET_MINUTES=330
